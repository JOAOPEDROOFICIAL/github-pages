<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CHLOE BOT - PrimeBot Solutions</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap" rel="stylesheet">
    <style>
         :root {
            --neon-color: #d61ab1;
            --bg-color: #0a0a0a;
            --text-color: #ffffff;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(160deg, #0a0a0a, #1a0026, #330033);
            background-size: 400% 400%;
            animation: galaxyAnimation 20s ease infinite;
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
        }
        
        @keyframes galaxyAnimation {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
        
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .logo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 3px solid var(--neon-color);
            box-shadow: 0 0 15px var(--neon-color);
            margin: 0 auto 15px;
            object-fit: cover;
            display: block;
        }
        
        h1,
        h2 {
            text-align: center;
            text-shadow: 0 0 10px var(--neon-color), 0 0 20px var(--neon-color);
            animation: glow 2s infinite alternate;
        }
        
        h1 {
            font-size: 2.3em;
            color: var(--neon-color);
        }
        
        h2 {
            font-size: 1.5em;
            margin-bottom: 30px;
        }
        
        @keyframes glow {
            from {
                text-shadow: 0 0 10px var(--neon-color), 0 0 20px var(--neon-color);
            }
            to {
                text-shadow: 0 0 20px var(--neon-color), 0 0 30px var(--neon-color);
            }
        }
        
        .bot-link {
            padding: 10px 25px;
            background: linear-gradient(to right, #d61ab1, #ff8ee0);
            color: #000;
            text-decoration: none;
            font-size: 1em;
            border-radius: 10px;
            box-shadow: 0 0 10px var(--neon-color), 0 0 20px var(--neon-color);
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 40px;
        }
        
        .bot-link:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px var(--neon-color), 0 0 30px var(--neon-color);
        }
        
        .section {
            width: 100%;
            max-width: 1200px;
            margin-bottom: 60px;
        }
        
        .section h3 {
            font-size: 1.5em;
            margin-bottom: 20px;
            color: var(--neon-color);
            text-align: center;
            text-shadow: 0 0 10px var(--neon-color);
        }
        
        .plans {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }
        
        .plan {
            background-color: #1a1a1a;
            border: 2px solid var(--neon-color);
            border-radius: 10px;
            padding: 20px;
            width: 300px;
            text-align: center;
            box-shadow: 0 0 10px var(--neon-color);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .plan:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px var(--neon-color);
        }
        
        .plan h4 {
            font-size: 1.3em;
            margin-bottom: 10px;
            color: var(--neon-color);
        }
        
        .plan p {
            font-size: 1.1em;
            margin-bottom: 15px;
        }
        
        .support-section {
            width: 100%;
            text-align: center;
            background-color: #1a1a1a;
            padding: 30px;
            border-radius: 15px;
            border: 2px solid var(--neon-color);
            box-shadow: 0 0 20px var(--neon-color);
            margin-bottom: 60px;
        }
        
        .support-section h3 {
            color: var(--neon-color);
            margin-bottom: 20px;
            text-shadow: 0 0 10px var(--neon-color);
        }
        
        .pix-key {
            font-size: 1.2em;
            background-color: #000;
            padding: 10px 20px;
            display: inline-block;
            border-radius: 10px;
            color: var(--neon-color);
            box-shadow: 0 0 15px var(--neon-color);
            margin-top: 10px;
        }
        
        .who-we-are {
            width: 100%;
            background-color: #1a1a1a;
            padding: 30px;
            border-radius: 15px;
            border: 2px solid var(--neon-color);
            box-shadow: 0 0 20px var(--neon-color);
            margin-bottom: 60px;
        }
        
        .who-we-are h3 {
            text-align: center;
            margin-bottom: 20px;
            color: var(--neon-color);
        }
        
        .who-we-are .team {
            font-size: 1.1em;
            text-align: center;
        }
        
        .footer {
            font-size: 1em;
            color: var(--neon-color);
            text-align: center;
            text-shadow: 0 0 10px var(--neon-color);
            margin-bottom: 30px;
        }
    </style>
</head>

